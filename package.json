{
  "name": "@dahuangggg/opencode-headroom",
  "version": "0.3.1",
  "description": "Headroom-compatible native OpenCode plugin for tool-output compression and CCR retrieval",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-compression",
    "tool-output",
    "headroom",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahuangggg/opencode-headroom.git"
  },
  "homepage": "https://github.com/dahuangggg/opencode-headroom#readme",
  "bugs": {
    "url": "https://github.com/dahuangggg/opencode-headroom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "opencode.json.example",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:check": "bun benchmarks/check.ts",
    "bench:oracle:refresh": "bun benchmarks/parity/refresh.ts",
    "bench:quality": "bun benchmarks/parity/run.ts",
    "bench:report": "bun benchmarks/headroom-cost-experiment.ts --report",
    "bench:perf": "bun benchmarks/performance.ts",
    "lint:package": "node scripts/package-lint.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lezer/javascript": "^1.5.4",
    "@lezer/python": "^1.1.19",
    "@opencode-ai/plugin": "^1.17.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  },
  "license": "Apache-2.0"
}
