{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@dahuangggg/opencode-headroom",
      {
        "engine": "native",
        "profile": "coding",
        "readLifecycle": true,
        "ttlHours": 24,
        "storage": {
          "kind": "auto",
          "path": ".headroom/ccr.sqlite",
          "maxEntries": 10000,
          "busyTimeoutMs": 5000
        },
        "toolPolicy": {
          "default": {
            "action": "compress",
            "strength": "balanced"
          },
          "rules": [
            {
              "id": "preserve-exact-code",
              "tools": ["Read", "Edit", "Write", "apply_patch"],
              "action": "preserve"
            },
            {
              "id": "compress-shell-output",
              "tools": ["Bash"],
              "action": "compress",
              "strength": "balanced",
              "minimum": {
                "tokens": 2000,
                "chars": 8000
              },
              "ccr": {
                "ttlHours": 24
              },
              "retrieve": {
                "defaultMode": "summary",
                "maxChars": 12000
              }
            }
          ]
        },
        "outputFiles": {
          "allowedRoots": ["."],
          "trustedTools": ["Bash"]
        },
        "maxOutputChars": 250000,
        "debug": false,
        "debugLevel": "summary",
        "debugSink": "metadata",
        "debugPath": ".headroom/debug.ndjson"
      }
    ]
  ]
}
